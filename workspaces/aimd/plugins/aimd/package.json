    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.34.4",
    "@backstage/core-app-api": "backstage:^",
    "@backstage/dev-utils": "backstage:^",
