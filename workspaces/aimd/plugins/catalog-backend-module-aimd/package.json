{
  "name": "@backstage-community/plugin-catalog-backend-module-aimd",
  "description": "The aimd backend module for the catalog plugin.",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/community-plugins",
    "directory": "workspaces/aimd/plugins/catalog-backend-module-aimd"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "aimd",
    "pluginPackages": [
      "@backstage-community/plugin-aimd",
      "@backstage-community/plugin-aimd-common",
      "@backstage-community/plugin-catalog-backend-module-aimd"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "backstage:^",
    "@backstage/catalog-model": "backstage:^",
    "@backstage/plugin-catalog-node": "backstage:^",
    "@backstage-community/plugin-aimd-common": "workspace:^"
  },
  "devDependencies": {
    "@backstage/backend-test-utils": "backstage:^",
    "@backstage/cli": "^0.34.4"
  },
  "files": [
    "dist"
  ]
}
